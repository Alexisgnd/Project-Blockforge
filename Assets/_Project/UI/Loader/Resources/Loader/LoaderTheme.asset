  splashSteps:
  - Loading parts
  - Building the arena
  - Waking the robots
  - Syncing the match
  - Ready
  buildFormat: "Build {0} \xB7 {1}"
  tips:
  - A robot loses the blocks it is hit on. Put your weapons where the armour is.
  - Keys 1, 2 and 3 switch between your weapon and module types.
  - Press R to self-right a robot that landed on its back.
  - Heavier builds take more hits, lighter builds get there first.
  screenPlans:
  - sceneName: Garage
    steps:
    - Entering the garage
    - Loading your bays
    - Placing the robot
    - Ready
  - sceneName: MainMenu
    steps:
    - Entering the hangar
    - Loading your bays
    - Placing the robot
    - Ready
  - sceneName: Map_Test
    steps:
    - Entering the test range
    - Building the arena
    - Placing the robot
    - Ready
  - sceneName: Map_MARS
    steps:
    - Entering the arena
    - Building the arena
    - Placing the robot
    - Ready
  - sceneName: Boot
    steps:
    - Back to sign-in
    - Ready
  defaultScreenSteps:
  - Loading
  - Ready
