<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="BootAuth.uss" />
    <ui:VisualElement name="screen" class="screen">

        <ui:VisualElement name="game-logo" class="game-logo" />

        <ui:VisualElement name="auth-container" class="auth-container">

            <!-- ================= STEAM (connexion automatique) ================= -->
            <ui:VisualElement name="steam-panel" class="panel">
                <ui:Label name="steam-title" text="SIGNING IN WITH STEAM" class="panel-title" />

                <ui:VisualElement class="steam-identity">
                    <ui:VisualElement name="steam-avatar" class="steam-avatar">
                        <ui:VisualElement name="steam-avatar-icon" class="steam-avatar-icon" />
                    </ui:VisualElement>
                    <ui:VisualElement class="steam-identity-text">
                        <ui:Label name="steam-name" text="…" class="steam-name" />
                        <ui:Label name="steam-sub" text="Steam account" class="steam-sub" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="steam-message" text="Checking your Steam ticket with the server…" class="steam-message" />

                <ui:Button name="steam-retry" text="RETRY" class="primary-button" />
                <ui:Button name="steam-offline" text="PLAY OFFLINE" class="secondary-button steam-offline-button" />

                <ui:VisualElement class="register-hint">
                    <ui:Label text="Prefer another account?" class="hint-label" />
                    <ui:Button name="goto-standard" text="Use an email account" class="link-button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ================= CONNEXION (Sign in) ================= -->
            <ui:VisualElement name="login-panel" class="panel">
                <ui:Label text="SIGN IN" class="panel-title" />

                <ui:TextField name="login-email" placeholder-text="Email" class="field" />

                <ui:VisualElement class="password-row">
                    <ui:TextField name="login-password" placeholder-text="Password" password="true" class="field password-field" />
                    <ui:Button name="login-password-toggle" text="" tooltip="Show password" class="eye-button" />
                </ui:VisualElement>

                <ui:VisualElement class="forgot-row">
                    <ui:Button name="forgot-password" text="Forgot your password?" class="link-button" />
                </ui:VisualElement>

                <ui:Button name="login-button" text="SIGN IN" class="primary-button" />

                <ui:VisualElement class="or-row">
                    <ui:VisualElement class="or-line" />
                    <ui:Label text="OR" class="or-label" />
                    <ui:VisualElement class="or-line" />
                </ui:VisualElement>

                <ui:Button name="guest-button" text="PLAY OFFLINE" class="secondary-button" />

                <ui:VisualElement class="register-hint">
                    <ui:Label text="No account yet?" class="hint-label" />
                    <ui:Button name="goto-register" text="Create one" class="link-button" />
                </ui:VisualElement>

                <ui:VisualElement name="steam-hint" class="register-hint">
                    <ui:Label text="Steam is running." class="hint-label" />
                    <ui:Button name="goto-steam" text="Sign in with Steam instead" class="link-button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ================= INSCRIPTION (Create account) ================= -->
            <ui:VisualElement name="register-panel" class="panel">
                <ui:Label text="CREATE ACCOUNT" class="panel-title" />

                <ui:TextField name="register-email" placeholder-text="Email" class="field" />
                <ui:TextField name="register-username" placeholder-text="Username" class="field" />

                <ui:VisualElement class="password-row">
                    <ui:TextField name="register-password" placeholder-text="Password" password="true" class="field password-field" />
                    <ui:Button name="register-password-toggle" text="" tooltip="Show password" class="eye-button" />
                </ui:VisualElement>

                <ui:VisualElement class="password-row">
                    <ui:TextField name="register-password-confirm" placeholder-text="Confirm password" password="true" class="field password-field" />
                    <ui:Button name="register-password-confirm-toggle" text="" tooltip="Show password" class="eye-button" />
                </ui:VisualElement>

                <ui:Button name="register-button" text="CREATE ACCOUNT" class="primary-button" />

                <ui:VisualElement class="register-hint">
                    <ui:Label text="Already have an account?" class="hint-label" />
                    <ui:Button name="goto-login" text="Sign in" class="link-button" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:Label name="status-label" text="" class="status-label status--hidden" />

    </ui:VisualElement>
</ui:UXML>
